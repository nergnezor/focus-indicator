{
    "manifest_version": 3,
    "name": "Spatial Nav Marks",
    "version": "1.0.0",
    "description": "Marks the focused spatial-navigation element with a soft wave.",
    "permissions": ["scripting", "tabs"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "lib/geometry.js",
                "lib/styles.js",
                "lib/shadow.js",
                "lib/overlay.js",
                "lib/runtime.js",
                "content.js"
            ],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
